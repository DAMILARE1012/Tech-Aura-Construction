# ==============================================================================
#  Tech-Aura — environment configuration
#
#  Copy to `.env` and fill in. `.env` is git-ignored; this example file is not.
#
#  ⚠️  EVERY VARIABLE PREFIXED `VITE_` IS COMPILED INTO THE PUBLIC BUNDLE.
#      Anyone can read it with browser devtools. It is NOT a secret store.
#
#      Never put an API key, token, password, database URL or private
#      credential behind a VITE_ prefix. Secrets belong on the server that
#      the frontend calls, never in this file.
#
#      Variables WITHOUT the VITE_ prefix (e.g. SITE_URL below) are used only
#      by Node build scripts and are never shipped to the browser.
# ==============================================================================


# --- Canonical site URL -------------------------------------------------------
# Drives every canonical tag, Open Graph URL, JSON-LD @id and sitemap entry.
# MUST match the domain you actually deploy to, including the www prefix,
# with no trailing slash. Getting this wrong is actively harmful for SEO:
# it points search engines at a domain that does not serve your content.
#
# Set BOTH — the app reads VITE_SITE_URL, the sitemap script reads SITE_URL.
VITE_SITE_URL=https://www.tech-aura.com.ng
SITE_URL=https://www.tech-aura.com.ng


# --- Backend API --------------------------------------------------------------
# Leave unset in development: RTK Query then serves everything from the
# in-browser mock in src/api/mockBackend.js, using the content in src/data.
# Set it to switch the whole app onto a real API with no code changes.
# VITE_API_BASE_URL=https://api.tech-aura.com.ng/v1


# --- Homepage hero video ------------------------------------------------------
# Optional. Defaults to /media/hero.mp4 and /media/hero.webm in public/.
# Point these at a CDN to keep large video out of the repo.
# The poster is shown while the video buffers, if it is missing, and for
# visitors who have asked for reduced motion.
# VITE_HERO_VIDEO_URL=https://cdn.tech-aura.com.ng/hero.mp4
# VITE_HERO_VIDEO_WEBM=https://cdn.tech-aura.com.ng/hero.webm
# VITE_HERO_POSTER=/media/hero-poster.svg


# --- Development only ---------------------------------------------------------
# Artificial latency (ms) on the in-browser mock API, so loading and skeleton
# states are visible during development. Set to 0 for instant responses.
# Ignored entirely once VITE_API_BASE_URL is set.
# VITE_MOCK_LATENCY_MS=120
