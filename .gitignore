# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions
jspm_packages/

# Lockfiles from other package managers — this project uses npm.
yarn.lock
pnpm-lock.yaml
bun.lockb

# ---------------------------------------------------------------
# Build output and caches
# ---------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.vite/
.cache/
*.tsbuildinfo
.eslintcache
.oxlintcache
.stylelintcache

# ---------------------------------------------------------------
# Environment and secrets
#
# .env.example IS committed — it documents the variables without
# carrying any values. Never commit a real .env.
# ---------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
serviceAccount*.json

# ---------------------------------------------------------------
# Claude Code and other AI assistant files
#
# Local assistant config can hold machine paths, MCP server details
# and API keys, so it stays out of the repo.
#
# If your team later wants to SHARE project conventions, un-ignore
# CLAUDE.md and .claude/settings.json (the shared ones) and keep
# .claude/settings.local.json ignored — that one is personal.
# ---------------------------------------------------------------
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json
.claude-*

# Other assistants
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.windsurf/
.codeium/
.gemini/
.roo/
.specstory/

